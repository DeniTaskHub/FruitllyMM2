local function findMyGun()
    if LP.Character then
        for _, t in ipairs(LP.Character:GetChildren()) do
            if t:IsA("Tool") then
                local ok, has = pcall(function() return t:HasTag("Weapon_Gun") end)
                if (ok and has) or t.Name == "Gun" then return t, true end
            end
        end
    end
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") then
            local ok, has = pcall(function() return t:HasTag("Weapon_Gun") end)
            if (ok and has) or t.Name == "Gun" then return t, false end
        end
    end
    return nil, false
end
local function equipGun()
    local gun, equipped = findMyGun()
    if not gun then return nil end
    if not equipped then
        local h = getHum(LP) if h then h:EquipTool(gun) task.wait(0.15) gun = findMyGun() end
    end
    return gun
end
local function shootOnce(targetPlayer)
    if not targetPlayer or not alive(targetPlayer) then return false, "no target" end
    if targetPlayer == LP then return false, "cant shoot self" end
    local gun = equipGun()
    if not gun then return false, "no gun" end
    local shootRemote = gun:FindFirstChild("Shoot")
    if not shootRemote then return false, "no Shoot remote" end
    local myChar = LP.Character if not myChar then return false, "no character" end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart") if not myHRP then return false, "no HRP" end
    local tHRP = getHRP(targetPlayer) if not tHRP then return false, "target no HRP" end
    local originAttach = myHRP:FindFirstChild("GunRaycastAttachment")
    local originCFrame = originAttach and originAttach.WorldCFrame or myHRP.CFrame
    local targetCFrame = CFrame.new(tHRP.Position)
    local ok, err = pcall(function() shootRemote:FireServer(originCFrame, targetCFrame) end)
    return ok, err
end

