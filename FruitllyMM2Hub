local knifeAuraConn
onStateChange("KnifeAura", function(v)
    if knifeAuraConn then knifeAuraConn:Disconnect() knifeAuraConn=nil end
    if v then
        if not isRoundActive() then
            toast("KNIFE AURA","Lobby - wait for round","warn")
            setState("KnifeAura",false) return
        end
        if getMyRole() ~= "Murderer" then
            toast("KNIFE AURA","Only as Murderer","warn")
            setState("KnifeAura",false) return
        end
        toast("KNIFE AURA","Radius "..State.KnifeRadius,"info")
        local accum = 0
        knifeAuraConn = RS.Heartbeat:Connect(function(dt)
            if not State.KnifeAura then return end
            accum = accum + dt
            if accum < 0.1 then return end
            accum = 0
            if not isRoundActive() then setState("KnifeAura",false) return end
            if getMyRole() ~= "Murderer" then setState("KnifeAura",false) return end
            local myHRP = getHRP(LP) if not myHRP then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and alive(p) then
                    local ph = getHRP(p)
                    if ph and (ph.Position - myHRP.Position).Magnitude <= State.KnifeRadius then
                        knifeStabTarget(p)
                    end
                end
            end
        end)
    else toast("KNIFE AURA","Disabled","info") end
end)

