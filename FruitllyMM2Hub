-- GRAB GUN — silent (firetouchinterest) primary, physical fallback, all gates + nil guards
local GRAB_MURDERER_SAFE_RADIUS = 25

local function grabGunWithReturn(callback)
    -- gate 1: round active
    if not isRoundActive() then
        if callback then callback(false, "lobby - wait for round") end return
    end
    -- gate 2: not spectator
    local myRole = getMyRole()
    if myRole == "Lobby" or myRole == "Unknown" then
        if callback then callback(false, "spectator - wait to join round") end return
    end
    -- gate 3: alive
    if not alive(LP) then
        if callback then callback(false, "you are dead") end return
    end
    -- gate 4: innocent only
    if myRole ~= "Innocent" then
        if callback then callback(false, "innocent only (you are "..myRole..")") end return
    end

    local hrp = getHRP(LP)
    if not hrp then if callback then callback(false, "no character") end return end

    -- lock original position ONCE at very top
    local ORIGINAL_CFRAME = hrp.CFrame
    if not ORIGINAL_CFRAME then
        if callback then callback(false, "couldn't lock position") end return
    end

    local gunDrop = findGunDropCached()
    if not gunDrop then if callback then callback(false, "no gun drop") end return end

    task.spawn(function()
        local function haveGun()
            for _, t in ipairs(LP.Backpack:GetChildren()) do
                if t:IsA("Tool") then
                    local hok, has = pcall(function() return t:HasTag("Weapon_Gun") end)
                    if (hok and has) or t.Name == "Gun" then return true end
                end
            end
            if LP.Character then
                for _, t in ipairs(LP.Character:GetChildren()) do
                    if t:IsA("Tool") then
                        local hok, has = pcall(function() return t:HasTag("Weapon_Gun") end)
                        if (hok and has) or t.Name == "Gun" then return true end
                    end
                end
            end
            return false
        end

        -- TIER 1: firetouchinterest silent grab
        local tier1ok = pcall(function()
            if firetouchinterest then
                firetouchinterest(hrp, gunDrop, 0)
                task.wait(0.05)
                firetouchinterest(hrp, gunDrop, 1)
            else
                error("firetouchinterest not available")
            end
        end)

        if tier1ok then
            task.wait(0.2)
            if haveGun() then
                if callback then callback(true, "silent") end return
            end
        end

        -- TIER 2: getconnections fallback
        pcall(function()
            if getconnections then
                for _, conn in ipairs(getconnections(gunDrop.Touched) or {}) do
                    pcall(function() conn:Fire(hrp) end)
                end
                task.wait(0.15)
            end
        end)
        if haveGun() then
            if callback then callback(true, "connection fire") end return
        end

        -- retry TIER 1 a few more times
        for i = 1, 5 do
            if not gunDrop.Parent then break end
            if not alive(LP) then break end
            pcall(function()
                if firetouchinterest then
                    firetouchinterest(hrp, gunDrop, 0)
                    firetouchinterest(hrp, gunDrop, 1)
                end
            end)
            task.wait(0.1)
            if haveGun() then
                if callback then callback(true, "silent retry") end return
            end
        end

        -- TIER 3: physical teleport (LAST RESORT)
        toast("GRAB GUN", "Silent failed - physical grab", "warn")
        for i = 1, 10 do
            if not gunDrop or not gunDrop.Parent then break end
            if not alive(LP) then break end
            local liveHRP = getHRP(LP)
            if not liveHRP then break end

            local gunPos = gunDrop.CFrame
            if not gunPos then break end
            pcall(function() liveHRP.CFrame = gunPos + Vector3.new(0, 3, 0) end)
            task.wait(0.08)
            if haveGun() then
                task.wait(0.1)
                for j = 1, 8 do
                    local finalHRP = getHRP(LP)
                    if finalHRP and ORIGINAL_CFRAME then
                        pcall(function() finalHRP.CFrame = ORIGINAL_CFRAME end)
                        pcall(function() finalHRP.Velocity = Vector3.new(0, 0, 0) end)
                        pcall(function() finalHRP.RotVelocity = Vector3.new(0, 0, 0) end)
                        pcall(function() finalHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                        pcall(function() finalHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
                        if (finalHRP.Position - ORIGINAL_CFRAME.Position).Magnitude < 5 then break end
                    end
                    task.wait(0.05)
                end
                if callback then callback(true, "physical") end return
            end
        end

        -- all tiers failed → aggressive return
        local finalHRP = getHRP(LP)
        if finalHRP and ORIGINAL_CFRAME then
            for j = 1, 5 do
                pcall(function() finalHRP.CFrame = ORIGINAL_CFRAME end)
                pcall(function() finalHRP.Velocity = Vector3.new(0, 0, 0) end)
                if (finalHRP.Position - ORIGINAL_CFRAME.Position).Magnitude < 5 then break end
                task.wait(0.05)
            end
        end
        if callback then callback(false, "grab failed") end
    end)
end

local function equipKnifeIfNeeded()
    local char = LP.Character if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            local ok, has = pcall(function() return t:HasTag("Weapon_Knife") end)
            if (ok and has) or t.Name == "Knife" then return t end
        end
    end
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") then
            local ok, has = pcall(function() return t:HasTag("Weapon_Knife") end)
            if (ok and has) or t.Name == "Knife" then
                local h = getHum(LP) if h then h:EquipTool(t) end return t
            end
        end
    end
    return nil
end
local function knifeStabTarget(target)
    if not target or target == LP or not alive(target) then return false end
    local knife = equipKnifeIfNeeded()
    if not knife then return false end
    local events = knife:FindFirstChild("Events")
    if not events then return false end
    local handleTouched = events:FindFirstChild("HandleTouched")
    local knifeStabbed = events:FindFirstChild("KnifeStabbed")
    local targetHRP = getHRP(target)
    if not targetHRP then return false end
    if handleTouched then pcall(function() handleTouched:FireServer(targetHRP) end) end
    if knifeStabbed then pcall(function() knifeStabbed:FireServer(targetHRP) end) end
    return true
end

