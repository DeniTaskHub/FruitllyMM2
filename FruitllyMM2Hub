onStateChange("AutoGrabGun", function(v)
    if autoGrabConn then autoGrabConn:Disconnect() autoGrabConn=nil end
    if v then
        toast("AUTO GRAB","Monitoring","info")
        autoGrabConn = Workspace.DescendantAdded:Connect(function(obj)
            if not State.AutoGrabGun then return end
            if autoGrabInProgress then return end
            if not alive(LP) then return end
            if not obj:IsA("BasePart") or obj.Name ~= "GunDrop" then return end
            _G.__FruitllySetCachedGunDrop(obj)
            autoGrabInProgress = true task.wait(0.05)
            grabGunWithReturn(function(ok, err)
                autoGrabInProgress = false
                if ok then toast("AUTO GRAB","Got gun ("..(err or "?")..")","info")
                else toast("AUTO GRAB", err or "Failed", "warn") end
            end)
        end)
        task.spawn(function()
