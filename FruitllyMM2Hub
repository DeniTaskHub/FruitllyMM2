local function switchTab(name)
    currentTab=name
    for k,page in pairs(pages) do page.Visible=(k==name) end
    for k,btn in pairs(tabButtons) do
        local a=(k==name)
        tween(btn.frame,{BackgroundColor3=a and COL.panel or COL.slot},0.15)
        tween(btn.label,{TextColor3=a and COL.text or COL.dim},0.15)
        btn.label.Font=a and Enum.Font.GothamBlack or Enum.Font.GothamBold
        btn.indicator.BackgroundTransparency=a and 0 or 1
    end
end
