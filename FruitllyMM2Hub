local transparencyTargets = {}
local function trackForTransparency(obj) table.insert(transparencyTargets, obj) end
local function applyTransparency()
    local alpha = State.GuiTransparency / 100
    for _, obj in ipairs(transparencyTargets) do
        if obj and obj.Parent then
            pcall(function()
                if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ScrollingFrame") or obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    local origBG = obj:GetAttribute("__origBG")
                    if origBG == nil then origBG = obj.BackgroundTransparency obj:SetAttribute("__origBG", origBG) end
                    if origBG < 1 then obj.BackgroundTransparency = math.clamp(origBG + alpha * (1 - origBG), 0, 1) end
                end
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local origTT = obj:GetAttribute("__origTT")
                    if origTT == nil then origTT = obj.TextTransparency obj:SetAttribute("__origTT", origTT) end
                    obj.TextTransparency = math.clamp(origTT + alpha * (1 - origTT), 0, 1)
                end
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                    local origIT = obj:GetAttribute("__origIT")
                    if origIT == nil then origIT = obj.ImageTransparency obj:SetAttribute("__origIT", origIT) end
                    obj.ImageTransparency = math.clamp(origIT + alpha * (1 - origIT), 0, 1)
                end
                if obj:IsA("UIStroke") then
                    local origST = obj:GetAttribute("__origST")
                    if origST == nil then origST = obj.Transparency obj:SetAttribute("__origST", origST) end
                    obj.Transparency = math.clamp(origST + alpha * (1 - origST), 0, 1)
                end
            end)
        end
    end
end
onStateChange("GuiTransparency", applyTransparency)

