-- ============================================================
-- ANTI FLING (collision-based)
-- ============================================================
local antiFlingConn
local antiFlingSitConn
local antiFlingCharAddedConn
local antiFlingScanAccum = 0
local ANTI_FLING_SCAN_INTERVAL = 0.1

local function setupAntiFlingCharacter(char)
    if not char then return end
    task.wait(0.3)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then pcall(function() hrp.Anchored = false end) end
    if antiFlingSitConn then antiFlingSitConn:Disconnect() end
    if hum then
        antiFlingSitConn = hum:GetPropertyChangedSignal("Sit"):Connect(function()
            if not State.AntiFling then return end
            if hum.Sit then hum.Sit = false end
        end)
    end
end

onStateChange("AntiFling", function(v)
    if antiFlingConn then antiFlingConn:Disconnect() antiFlingConn=nil end
    if antiFlingCharAddedConn then antiFlingCharAddedConn:Disconnect() antiFlingCharAddedConn=nil end
    if antiFlingSitConn then antiFlingSitConn:Disconnect() antiFlingSitConn=nil end

    if v then
        toast("ANTI FLING","Enabled (collision)","info")
        local existingHRP = getHRP(LP)
        if existingHRP then pcall(function() existingHRP.Anchored = false end) end
        if Workspace.FallenPartsDestroyHeight ~= Workspace.FallenPartsDestroyHeight
           or math.abs(Workspace.FallenPartsDestroyHeight) > 10000 then
            pcall(function() Workspace.FallenPartsDestroyHeight = -500 end)
        end

        if LP.Character then setupAntiFlingCharacter(LP.Character) end
        antiFlingCharAddedConn = LP.CharacterAdded:Connect(setupAntiFlingCharacter)

        antiFlingConn = RS.Heartbeat:Connect(function(dt)
            if not State.AntiFling then return end
            antiFlingScanAccum = antiFlingScanAccum + dt
            if antiFlingScanAccum < ANTI_FLING_SCAN_INTERVAL then return end
            antiFlingScanAccum = 0

            local char = LP.Character
            if not char then return end

            for _, part in ipairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") and not part.Anchored and not part:IsDescendantOf(char) then
                    local lv = part.AssemblyLinearVelocity
                    local av = part.AssemblyAngularVelocity
                    if lv.Magnitude > 3 or av.Magnitude > 3 then
                        pcall(function() part.CanCollide = false end)
                    end
                end
            end
        end)
    else
        toast("ANTI FLING","Disabled","info")
        local hum = getHum(LP)
        if hum then
            pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
        end
    end
end)

