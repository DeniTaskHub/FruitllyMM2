-- AUTO FARM v9.8 — cached container, counter-on-fire, server bag fallback
-- ============================================================
local farmActive = false

local function getCoinRemote()
    local remote
    pcall(function()
        remote = ReplicatedStorage.Remotes.Gameplay:FindFirstChild("GetCoin")
    end)
    return remote
end

local function getCoinPos(coin)
    if coin:IsA("BasePart") then return coin.Position end
    if coin:IsA("Model") then
        if coin.PrimaryPart then return coin.PrimaryPart.Position end
        local ok, pivot = pcall(function() return coin:GetPivot().Position end)
        if ok and pivot then return pivot end
        for _, ch in ipairs(coin:GetDescendants()) do
            if ch:IsA("BasePart") then return ch.Position end
        end
    end
    return nil
end

local function isCoinValid(coin)
    if not coin or not coin.Parent then return false end
    local visual = coin:FindFirstChild("CoinVisual")
    if visual then
        if not visual.Parent then return false end
        local mainCoin = visual:FindFirstChild("MainCoin")
        if mainCoin then
            if mainCoin:IsA("BasePart") and mainCoin.Transparency >= 1 then return false end
        end
    end
    if not getCoinPos(coin) then return false end
    return true
end

local cachedCoinContainer = nil
local function findCoinContainer()
    if cachedCoinContainer and cachedCoinContainer.Parent then
        return cachedCoinContainer
    end
    cachedCoinContainer = nil
    for _, child in ipairs(Workspace:GetChildren()) do
        local cc = child:FindFirstChild("CoinContainer")
        if cc then cachedCoinContainer = cc break end
    end
    if not cachedCoinContainer then
        cachedCoinContainer = Workspace:FindFirstChild("CoinContainer")
    end
    return cachedCoinContainer
end

local function findCoinsInMap()
    local coins = {}
    local container = findCoinContainer()
    if container then
        for _, obj in ipairs(container:GetChildren()) do
            if obj.Name == "Coin_Server" and isCoinValid(obj) then
                table.insert(coins, obj)
            end
        end
    end
    return coins
end

local function getServerCoinCount()
    if ProfileData and type(ProfileData) == "table" then
        local ok, count = pcall(function()
            local pd = ProfileData[LP.Name] or ProfileData[LP.UserId]
            if pd and pd.CurrentCoins then return pd.CurrentCoins end
            if pd and pd.Coins then return pd.Coins end
            return nil
        end)
        if ok and count then return count end
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, ui in ipairs(pg:GetDescendants()) do
            if ui:IsA("TextLabel") and ui.Text and ui.Text:match("^%d+$") then
                local parentName = ui.Parent and ui.Parent.Name or ""
                if parentName:lower():find("coin") then
                    local n = tonumber(ui.Text)
                    if n and n <= 40 then return n end
                end
            end
        end
    end
    return nil
end

local FARM_SPEED = 25
local COIN_COOLDOWN = 2
local MURDERER_SAFE_RADIUS = 45

local function isReallyAlive()
    local hum = getHum(LP)
    if not hum then return false end
    if hum.Health <= 0 then return false end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    local char = LP.Character
    if not char then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function setCharCollision(canCollide)
    local char = LP.Character if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            pcall(function() p.CanCollide = canCollide end)
        end
    end
end

local function tweenToCoin(hrp, coin)
    if not isCoinValid(coin) then return false end
    local targetPos = getCoinPos(coin)
    if not targetPos then return false end
    local distance = (targetPos - hrp.Position).Magnitude
    if distance < 4 then return true end
    local duration = math.max(distance / FARM_SPEED, 0.2)

    setCharCollision(false)

    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tw:Play()

    local finished = false
    tw.Completed:Connect(function() finished = true end)

    while not finished do
        if not State.AutoFarm or not farmActive then tw:Cancel() setCharCollision(true) return false end
        if not isReallyAlive() then tw:Cancel() setCharCollision(true) return false end
        if not isCoinValid(coin) then tw:Cancel() setCharCollision(true) return true end
        task.wait(0.05)
    end
    if not State.Noclip then setCharCollision(true) end
    return true
end

local coinsCollected = 0
local attemptedCoins = {}

local coinCollectedConn
pcall(function()
    local cc = ReplicatedStorage.Remotes.Gameplay:FindFirstChild("CoinCollected")
    if cc and cc:IsA("RemoteEvent") then
        coinCollectedConn = cc.OnClientEvent:Connect(function(...)
            for c, _ in pairs(attemptedCoins) do
                if not isCoinValid(c) then attemptedCoins[c] = nil end
            end
        end)
    end
end)

local function forceReset()
    local char = LP.Character
    if not char then return end
    pcall(function()
        Workspace.FallenPartsDestroyHeight = getgenv().__FruitllyFPDH or -500
    end)
    local head = char:FindFirstChild("Head")
    if head then
        pcall(function() head:Destroy() end)
    end
    task.wait(0.3)
    if not isReallyAlive() then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
        pcall(function() hum.Health = 0 end)
    end
    task.wait(0.3)
    if not isReallyAlive() then return end
    pcall(function() char:Destroy() end)
end

local function farmLoop()
    coinsCollected = 0
    attemptedCoins = {}
    local GetCoin = getCoinRemote()
    if not GetCoin then
        toast("AUTO FARM","GetCoin remote missing","warn")
        setState("AutoFarm", false) return
    end
    toast("AUTO FARM","Farming started","info")

    local wasInRound = false

    while State.AutoFarm and farmActive and (getgenv().__FruitllySessionAlive == nil or getgenv().__FruitllySessionAlive()) do
        local inRound = false
        if CurrentRoundClient and CurrentRoundClient.PlayerData then
            local pd = CurrentRoundClient.PlayerData[LP.Name]
            if pd and pd.Role then
                local r = tostring(pd.Role)
                if r == "Murderer" or r == "Sheriff" or r == "Hero" or r == "Innocent" then
                    inRound = true
                end
            end
        end
        if not inRound then
            if hasWeaponTag(LP, "Weapon_Knife") or hasWeaponTag(LP, "Weapon_Gun") then
                inRound = true
            end
        end

        if inRound and not wasInRound then
            coinsCollected = 0
            attemptedCoins = {}
            toast("AUTO FARM", "New round - counter reset", "info")
        end
        wasInRound = inRound

        local serverCount = getServerCoinCount()
        local atMax = (coinsCollected >= 40) or (serverCount and serverCount >= 40)

        if not isRoundActive() then
            attemptedCoins = {}
            task.wait(1)
        elseif not inRound then
            attemptedCoins = {}
            task.wait(2)
        elseif not isReallyAlive() then
            attemptedCoins = {}
            coinsCollected = 0
            if not State.Noclip then setCharCollision(true) end
            task.wait(2)
        elseif atMax then
            toast("AUTO FARM", "40 coins collected", "info")
            local myRole = getMyRole()
            if myRole == "Murderer" then
                toast("AUTO FARM", "Respawning (Murderer)", "info")
                forceReset()
            else
                local m = getMurderer()
                if m and alive(m) then
                    toast("AUTO FARM", "Flinging "..m.Name, "info")
                    flingActive["AutoFarm40"] = true
                    task.spawn(function()
                        skidFling(m, "AutoFarm40")
                        flingActive["AutoFarm40"] = false
                    end)
                    task.wait(3)
                    toast("AUTO FARM", "Respawning self", "info")
                    forceReset()
                else
                    toast("AUTO FARM", "No murderer - respawning", "warn")
                    forceReset()
                end
            end
            coinsCollected = 0
            attemptedCoins = {}
            if not State.Noclip then setCharCollision(true) end
            task.wait(3)
        else
            local now = tick()
            local count = 0
            for c, t in pairs(attemptedCoins) do
                if now - t > COIN_COOLDOWN or not isCoinValid(c) then
                    attemptedCoins[c] = nil
                else
                    count = count + 1
                end
            end
            if count > 100 then attemptedCoins = {} end

            local coins = findCoinsInMap()
            if #coins == 0 then
                task.wait(0.5)
            else
                local hrp = getHRP(LP)
                if not hrp then task.wait(0.3) else
                    local murdererPos
                    local murderer = getMurderer()
                    if murderer and murderer ~= LP and alive(murderer) then
                        local mHRP = getHRP(murderer)
                        if mHRP then murdererPos = mHRP.Position end
                    end

                    local best, bestD
                    for _, c in ipairs(coins) do
                        if isCoinValid(c) and not attemptedCoins[c] then
                            local pos = getCoinPos(c)
                            if pos then
                                local safe = true
                                if murdererPos then
                                    local distToMurderer = (pos - murdererPos).Magnitude
                                    if distToMurderer < MURDERER_SAFE_RADIUS then safe = false end
                                end
                                if safe then
                                    local d = (pos - hrp.Position).Magnitude
                                    if not bestD or d < bestD then bestD = d best = c end
                                end
                            end
                        end
                    end

                    if not best then
                        task.wait(0.3)
                    else
                        local reached = tweenToCoin(hrp, best)
                        if reached and isReallyAlive() and isCoinValid(best) then
                            local fireOk = pcall(function() GetCoin:FireServer(best) end)
                            attemptedCoins[best] = tick()
                            if fireOk then
                                coinsCollected = coinsCollected + 1
                                toast("AUTO FARM", "Coin "..coinsCollected.."/40", "info")
                            end
                            task.wait(0.15)
                        elseif reached and not isCoinValid(best) then
                            attemptedCoins[best] = tick()
                        end
                    end
                end
            end
        end
    end
end

onStateChange("AutoFarm", function(v)
