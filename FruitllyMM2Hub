local Listeners = {}
local function onStateChange(key, cb)
    Listeners[key] = Listeners[key] or {}
    table.insert(Listeners[key], cb)
end
local function setState(key, val)
    if State[key] == val then return end
    State[key] = val
    if Listeners[key] then
        for _, cb in ipairs(Listeners[key]) do
            if State[key] ~= val then break end
            pcall(cb, val)
        end
    end
end

local function getChar(plr) return plr and plr.Character end
local function getHRP(plr) local c = getChar(plr) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(plr) local c = getChar(plr) return c and c:FindFirstChildOfClass("Humanoid") end
local function alive(plr) local h = getHum(plr) return h and h.Health > 0 end

local function hasWeaponTag(plr, tag)
    local nameMatch = (tag == "Weapon_Knife") and "Knife" or (tag == "Weapon_Gun") and "Gun"
    local containers = {plr:FindFirstChild("Backpack"), plr.Character}
    for _, cont in ipairs(containers) do
        if cont then
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") then
                    local ok, has = pcall(function() return t:HasTag(tag) end)
                    if ok and has then return true end
                    if nameMatch and t.Name == nameMatch then return true end
                end
            end
        end
    end
    return false
end

local function isRoundActive()
    if CurrentRoundClient then
        local ok, active = pcall(function()
            if CurrentRoundClient.PlayerData then
                for _, pd in pairs(CurrentRoundClient.PlayerData) do
                    if pd.Role then
                        local r = tostring(pd.Role)
                        if r == "Murderer" or r == "Sheriff" or r == "Hero" then
                            return true
                        end
                    end
                end
            end
            return false
        end)
        if ok and active then return true end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if hasWeaponTag(p, "Weapon_Knife") or hasWeaponTag(p, "Weapon_Gun") then
            return true
        end
    end
    return false
end

local function detectRole(plr)
    if not plr then return "Unknown" end
    if not isRoundActive() then return "Lobby" end
    if hasWeaponTag(plr, "Weapon_Knife") then return "Murderer" end
    if hasWeaponTag(plr, "Weapon_Gun") then return "Sheriff" end
    if CurrentRoundClient and CurrentRoundClient.PlayerData then
        local pd = CurrentRoundClient.PlayerData[plr.Name]
        if pd and pd.Role then
            local r = tostring(pd.Role)
            if r == "Murderer" then return "Murderer" end
            if r == "Sheriff" or r == "Hero" then return "Sheriff" end
            if r == "Innocent" then return "Innocent" end
        end
    end
    if alive(plr) then return "Innocent" end
    return "Unknown"
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if alive(p) and detectRole(p) == "Murderer" then return p end
    end
    return nil
end
local function getSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if alive(p) and detectRole(p) == "Sheriff" then return p end
    end
    return nil
end
local function getMyRole() return detectRole(LP) end

