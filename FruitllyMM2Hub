-- ============================================================
-- CAMLOCK (smoothed + predictive)
-- ============================================================
local camlockConn local camlockTarget
local CAMLOCK_SMOOTHNESS = 0.35
local CAMLOCK_PREDICTION = 0.12
local CAMLOCK_AIM_HEIGHT = 0

local function getRoleLimitedMouseTarget()
    local myRole = getMyRole()
    local mouse = LP:GetMouse()
    local best, bestDist
    local cam = Workspace.CurrentCamera
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and alive(p) then
            local targetRole = detectRole(p)
            local allowed = false
            if myRole == "Murderer" then allowed = true
            else allowed = (targetRole == "Murderer") end
            if allowed then
                local ph = getHRP(p)
                if ph then
                    local sp, vis = cam:WorldToScreenPoint(ph.Position)
                    if vis then
                        local d = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(sp.X, sp.Y)).Magnitude
                        if not bestDist or d < bestDist then bestDist=d best=p end
                    end
                end
            end
        end
    end
    return best
end
onStateChange("Camlock", function(v)
    if camlockConn then camlockConn:Disconnect() camlockConn=nil end
    if v then
        if not isRoundActive() then
            toast("CAMLOCK","Lobby - wait for round","warn")
            setState("Camlock",false) return
        end
        local myRole = getMyRole()
        camlockTarget = getRoleLimitedMouseTarget()
        if not camlockTarget then
            local reason = (myRole == "Murderer") and "No target" or "Murderer not visible"
            toast("CAMLOCK", reason, "warn")
            setState("Camlock", false) return
        end
        toast("CAMLOCK", camlockTarget.Name, "info")

        local lastTargetPos = nil
        local lastFrameTime = tick()
        local smoothedTargetPos = nil

        camlockConn = RS.RenderStepped:Connect(function(dt)
            if not State.Camlock then return end
            if not isRoundActive() then setState("Camlock",false) camlockTarget=nil return end
            if not camlockTarget or not alive(camlockTarget) then
                setState("Camlock",false) camlockTarget=nil return
            end
            local currentRole = getMyRole()
            local targetRole = detectRole(camlockTarget)
            if currentRole ~= "Murderer" and targetRole ~= "Murderer" then
                setState("Camlock", false) camlockTarget = nil
                toast("CAMLOCK", "Target no longer valid", "warn") return
            end

            local ph = getHRP(camlockTarget)
            local cam = Workspace.CurrentCamera
            if not ph or not cam then return end

            local rawTargetPos = ph.Position + Vector3.new(0, CAMLOCK_AIM_HEIGHT, 0)

            local predictedPos = rawTargetPos
            if lastTargetPos then
                local frameDelta = tick() - lastFrameTime
                if frameDelta > 0 then
                    local velocity = (rawTargetPos - lastTargetPos) / frameDelta
                    local hrpVel = ph.AssemblyLinearVelocity or ph.Velocity
                    local avgVel = (velocity + hrpVel) * 0.5
                    predictedPos = rawTargetPos + (avgVel * CAMLOCK_PREDICTION)
                end
            end
            lastTargetPos = rawTargetPos
            lastFrameTime = tick()

            if smoothedTargetPos then
                local lerpFactor = 1 - (CAMLOCK_SMOOTHNESS ^ (dt * 60))
                smoothedTargetPos = smoothedTargetPos:Lerp(predictedPos, lerpFactor)
            else
                smoothedTargetPos = predictedPos
            end

            cam.CFrame = CFrame.new(cam.CFrame.Position, smoothedTargetPos)
        end)
    else camlockTarget=nil toast("CAMLOCK","Disabled","info") end
end)

