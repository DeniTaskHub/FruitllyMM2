local floatingButtons={}
local floatingPositions={}
_G.__ResetFloatingPositions=function()
    local i = 0
    for name, frame in pairs(floatingButtons) do
        local pos = UDim2.new(0.5, -60 + i * 30, 0.5, -28 + i * 30)
        frame.Position = pos floatingPositions[name] = pos i = i + 1
    end
end

local ACTION_FEATURES = { Shoot = true, KillAll = true, GrabGun = true }

local function createFloatingButton(featureName)
    if floatingButtons[featureName] then return end
    local btn=newFrame({
        Name=featureName, Size=UDim2.new(0,120,0,56),
        Position=floatingPositions[featureName] or (function()
            local n = 0
            for _ in pairs(floatingButtons) do n = n + 1 end
            return UDim2.new(0.5, -60 + n * 30, 0.5, -28 + n * 30)
        end)(),
        BackgroundColor3=Color3.fromRGB(50, 40, 85), Active=true,
    })
    btn.Parent=fgui corner(btn,10)
    local nameLbl=Instance.new("TextLabel",btn)
    nameLbl.BackgroundTransparency=1 nameLbl.Size=UDim2.new(1,0,0,20)
    nameLbl.Position=UDim2.new(0,0,0,6)
    nameLbl.Text=FEATURE_LABELS[featureName] or featureName
    nameLbl.Font=Enum.Font.GothamBlack nameLbl.TextSize=11 nameLbl.TextColor3=COL.text
    local stateLbl=Instance.new("TextLabel",btn)
    stateLbl.BackgroundTransparency=1 stateLbl.Size=UDim2.new(1,0,0,20)
    stateLbl.Position=UDim2.new(0,0,0,28) stateLbl.Text="OFF"
    stateLbl.Font=Enum.Font.GothamBlack stateLbl.TextSize=14 stateLbl.TextColor3=COL.dim
    local isAction = ACTION_FEATURES[featureName]
    local isToggleFeature = (State[featureName] ~= nil) and not isAction
    local function render(v)
        if v then stateLbl.Text="ON" stateLbl.TextColor3=COL.green btn.BackgroundColor3=Color3.fromRGB(55,80,55)
        else stateLbl.Text="OFF" stateLbl.TextColor3=COL.dim btn.BackgroundColor3=Color3.fromRGB(50,40,85) end
    end
    if isToggleFeature then
        render(State[featureName])
        onStateChange(featureName,render)
    else
        stateLbl.Text="TAP" stateLbl.TextColor3=COL.cyan
    end
    local pressed=false local dragged=false
    local pressStart,pressStartPos
    btn.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            pressed=true dragged=false pressStart=input.Position pressStartPos=btn.Position
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            if pressed and not dragged then
                if isToggleFeature then
                    setState(featureName,not State[featureName])
                elseif featureName == "Shoot" then
                    if getMyRole() ~= "Sheriff" then toast("SHOOT","Not sheriff/hero","warn")
                    else
                        local m = getMurderer()
                        if not m then toast("SHOOT","No murderer","warn")
                        else
                            local ok = shootOnce(m)
                            if ok then toast("SHOOT","Fired","info")
                            else toast("SHOOT","Failed","warn") end
                        end
                    end
                elseif featureName == "KillAll" then
                    if _G.__FruitllyKillAll then _G.__FruitllyKillAll() end
                elseif featureName == "GrabGun" then
                    if _G.__FruitllyGrabGun then
                        _G.__FruitllyGrabGun(function(ok, err)
                            if ok then toast("GRAB GUN","Got gun ("..(err or "?")..")","info")
                            else toast("GRAB GUN", err or "Failed", "warn") end
                        end)
                    end
                end
            end
            pressed=false dragged=false
        end
    end)
    trackConn(UIS.InputChanged:Connect(function(input)
        if pressed and not State.FloatingLocked and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local delta=input.Position-pressStart
            if delta.Magnitude>6 then dragged=true end
            if dragged then
                btn.Position=UDim2.new(pressStartPos.X.Scale,pressStartPos.X.Offset+delta.X,pressStartPos.Y.Scale,pressStartPos.Y.Offset+delta.Y)
                floatingPositions[featureName]=btn.Position
            end
        end
    end))
    floatingButtons[featureName]=btn
end
local function destroyFloatingButton(featureName)
    if floatingButtons[featureName] then
        floatingPositions[featureName]=floatingButtons[featureName].Position
        floatingButtons[featureName]:Destroy() floatingButtons[featureName]=nil
    end
end
local function refreshFloatingButtons()
    if not State.FloatingEnabled then
        for name in pairs(floatingButtons) do destroyFloatingButton(name) end return
    end
    local wanted={}
    for name,en in pairs(State.EnabledFloating) do if en then wanted[name]=true end end
    for name in pairs(floatingButtons) do
        if not wanted[name] then destroyFloatingButton(name) end
    end
    for name in pairs(wanted) do
        if not floatingButtons[name] then createFloatingButton(name) end
    end
end
onStateChange("FloatingEnabled",refreshFloatingButtons)

