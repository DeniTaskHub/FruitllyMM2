local function updateESPLabels()
    if State.ESP then
        local myHRP = getHRP(LP)
        for p, d in pairs(espData) do
            if not d or not p.Character or not alive(p) then clearESPFor(p)
            else
                local color = roleColor(p)
                if d.color ~= color then
                    d.highlight.FillColor=color d.highlight.OutlineColor=color
                    d.nameLabel.TextColor3=color d.color=color
                end
                d.nameLabel.Text = State.ESPNames and p.Name or ""
